# ============================================
# CONFIGURACIÓN DEL BACKEND
# ============================================
# Copia este archivo a .env y personaliza los valores

# ============================================
# DJANGO - Configuración básica
# ============================================

# SECRET_KEY: Clave secreta para Django (OBLIGATORIO)
# Genera una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ⚠️ NUNCA uses la clave por defecto en producción
SECRET_KEY=tu-clave-secreta-aqui-genera-una-nueva

# DEBUG: Modo de depuración (True/False)
# ⚠️ SIEMPRE debe ser False en producción
DEBUG=False

# ALLOWED_HOSTS: Dominios permitidos (separados por coma)
# Ejemplo: tudominio.com,www.tudominio.com,api.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS_ALLOWED_ORIGINS: Orígenes permitidos para CORS (separados por coma)
# Debe incluir la URL del frontend
# Ejemplo: https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# BASE DE DATOS
# ============================================

# SQLite (por defecto, para desarrollo)
# No requiere configuración, se crea automáticamente en backend/db.sqlite3

# PostgreSQL (recomendado para producción)
# Descomenta y configura si usas PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db
# Ejemplo Render: postgresql://user:pass@dpg-xxxxx.oregon-postgres.render.com/dbname

# ============================================
# CLOUDINARY - Almacenamiento de imágenes
# ============================================
# Obtén tus credenciales en: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_SECURE=True

# ============================================
# PAYPAL - Pagos
# ============================================
# Obtén tus credenciales en: https://developer.paypal.com/dashboard/applications

# PAYPAL_MODE: 'sandbox' para pruebas, 'live' para producción
PAYPAL_MODE=sandbox

# Credenciales de la aplicación PayPal
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret

# Webhook ID (para recibir notificaciones de PayPal)
# Configura el webhook en: https://developer.paypal.com/dashboard/webhooks
# URL del webhook: https://tu-backend.com/api/payments/paypal/webhook/
PAYPAL_WEBHOOK_ID=tu-webhook-id

# ============================================
# REDIS - Cache y WebSockets (OPCIONAL)
# ============================================
# Redis mejora el rendimiento pero no es obligatorio

# URL de Redis
# Local: redis://localhost:6379/0
# Render: redis://red-xxxxx:6379
REDIS_URL=redis://localhost:6379/0

# Si no tienes Redis, las tareas se ejecutarán síncronamente
# Descomenta esta línea para ejecutar tareas sin Redis:
# CELERY_TASK_ALWAYS_EAGER=True

# ============================================
# EMAIL - Notificaciones (OPCIONAL)
# ============================================
# Para enviar emails de notificación

# Gmail (recomendado)
# Genera una App Password en: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tu Servidor <noreply@tuservidor.com>

# ============================================
# JWT - Tokens de autenticación
# ============================================

# Duración del token de acceso (en horas)
JWT_ACCESS_TOKEN_HOURS=24

# Duración del token de refresco (en días)
JWT_REFRESH_TOKEN_DAYS=14

# ============================================
# FRONTEND - URL del frontend
# ============================================

# URL donde está desplegado el frontend
# Desarrollo: http://localhost:5173
# Producción: https://tudominio.com
FRONTEND_URL=http://localhost:5173

# ============================================
# SEGURIDAD - Cookies
# ============================================

# AUTH_COOKIE_SECURE: True en producción (requiere HTTPS)
AUTH_COOKIE_SECURE=False

# AUTH_COOKIE_DOMAIN: Dominio de las cookies (opcional)
# Ejemplo: .tudominio.com (permite subdominios)
# AUTH_COOKIE_DOMAIN=

# ============================================
# RENDER - Configuración específica (si usas Render)
# ============================================

# RENDER: True si estás en Render.com
RENDER=False

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# 1. NUNCA subas este archivo .env a Git
# 2. Genera un SECRET_KEY único para cada instalación
# 3. Usa DEBUG=False en producción
# 4. Configura ALLOWED_HOSTS con tus dominios reales
# 5. Usa PostgreSQL en producción (SQLite es solo para desarrollo)
# 6. Configura Cloudinary para almacenar imágenes en producción
# 7. Usa PAYPAL_MODE=live solo cuando estés listo para producción
# 8. Mantén tus credenciales seguras y no las compartas
#
