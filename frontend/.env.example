# ============================================
# CONFIGURACIÓN DEL FRONTEND
# ============================================
# Copia este archivo a .env y personaliza los valores

# ============================================
# BRANDING - Personalización
# ============================================

# Nombre de tu plataforma/servidor
# Aparece en el navbar del dashboard y en el título de la página
VITE_APP_NAME=Mi Servidor MC

# ============================================
# BACKEND - Conexión con la API
# ============================================

# URL del backend (REQUERIDO en producción)
# 
# DESARROLLO:
# VITE_BACKEND_URL=http://localhost:8000
#
# PRODUCCIÓN:
# VITE_BACKEND_URL=https://api.tudominio.com
# VITE_BACKEND_URL=https://tu-backend.onrender.com
#
# ⚠️ NO incluyas /api al final, solo la URL base
VITE_BACKEND_URL=http://localhost:8000

# ============================================
# PLUGIN - Configuración de Minecraft
# ============================================

# Comando del plugin de Minecraft (sin el prefijo !)
# 
# Ejemplos:
# - Si usas "!shop claim" → pon "shop"
# - Si usas "!tienda reclamar" → pon "tienda"
# - Si usas "!store claim" → pon "store"
#
# Este comando se muestra en las instrucciones de entrega
VITE_PLUGIN_COMMAND=shop

# ============================================
# FOOTER - Branding
# ============================================

# Mostrar branding en el footer de la tienda pública
# 
# true = muestra "Powered by [VITE_APP_NAME]"
# false = no muestra branding (más white label)
#
# Recomendado: false para white label completo
VITE_SHOW_FOOTER_BRANDING=false

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. Todas las variables que empiezan con VITE_ son accesibles en el frontend
# 2. Después de cambiar estas variables, reinicia el servidor de desarrollo
# 3. En producción, configura estas variables en tu servicio de hosting:
#    - Vercel: Settings → Environment Variables
#    - Netlify: Site settings → Build & deploy → Environment
#    - Render: Environment → Environment Variables
# 4. NUNCA expongas credenciales sensibles en variables VITE_
#    (son públicas en el código del navegador)
#
