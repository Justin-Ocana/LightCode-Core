# Root .gitignore for lightcode

# Environment files
.env
.env.local
.env.*.local
.env.production
*.env

# Admin credentials (generated by create_admin.py)
.admin_credentials
client-config.json

# Security - Keys and certificates
*.pem
*.key
*.crt
*.p12

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
backend/db.sqlite3
backend/*.sqlite3
backend/media/
backend/staticfiles/
frontend/node_modules/
frontend/dist/
frontend/build/
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sensitive / local data (never commit)
.env.*
!.env.example
production_data.json
seller_backup.json
*.sqlite3
celerybeat-schedule*
backend/media/
